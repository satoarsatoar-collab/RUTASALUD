# Copia este archivo como .env para probar en tu computador.
# En Vercel, estas mismas variables se cargan en Settings > Environment Variables.

# --- IA (opcional) ---
# Créala en console.anthropic.com. NUNCA la pegues en index.html.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
RATE_LIMIT=12

# --- Panel del administrador ---
# Usuario y contraseña (mínimo 10 caracteres). Sin ellas el panel queda desactivado.
ADMIN_USER=
ADMIN_PASS=

# --- Base de datos de casos (Redis tipo Upstash) ---
# En Vercel: Storage > Marketplace > Upstash for Redis. Pone estas variables sola.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Días que se conserva un caso antes de borrarse solo (por defecto 365).
CASE_TTL_DAYS=365
# Si cambias el texto legal de autorización, sube la versión (v2, v3...) en ESTA variable
# y también en CONFIG.versionConsentimiento de index.html.
CONSENT_VERSION=v1

# --- Opcional ---
# Solo si el HTML está en un dominio distinto al de la API. Ej.: https://rutasalud.co
ALLOWED_ORIGIN=
